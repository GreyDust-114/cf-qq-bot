{
  "name": "qq-ai-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "QQ official bot on Cloudflare Workers + Durable Objects + D1 + DeepSeek",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GreyDust-114/cf-qq-bot.git"
  },
  "scripts": {
    "setup": "git config core.hooksPath .githooks && git config commit.template .gitmessage",
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "test": "node --test \"test/*.test.js\"",
    "test:watch": "node --test --watch \"test/*.test.js\"",
    "check": "node scripts/check-syntax.js",
    "verify": "npm run check && npm test"
  },
  "devDependencies": {
    "wrangler": "^4.136.1"
  }
}
